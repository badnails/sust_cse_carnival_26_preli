# Server
PORT=8000

# Google Gemini
# Leave empty to run with the rule-based fallback only.
# Preferred for multiple independent quota pools. Comma-separated.
GEMINI_API_KEYS=

# Single-key fallback. Also accepts comma-separated values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000

# Optional alias supported by the app if GEMINI_API_KEYS and GEMINI_API_KEY are not set.
GOOGLE_API_KEY=
